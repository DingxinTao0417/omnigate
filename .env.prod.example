# Copy to .env on the server and fill in real values. Never commit .env.
#
# Generate each secret with:  openssl rand -hex 32

DOMAIN=omnigate.cc
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Signs auth tokens. Changing it invalidates every existing session.
SESSION_SECRET=
# HMACs cache keys. Must match SESSION_SECRET's stability guarantees.
CRYPTO_SECRET=

TZ=Asia/Shanghai
